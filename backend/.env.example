# 复制为 .env 后按实际环境填写（.env 已被 gitignore，不会提交）

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=softteststudyt

# JWT
# 生产环境务必设置强随机密钥
JWT_SECRET=
JWT_EXPIRES_IN=168

# 服务
SERVER_PORT=3000

# 管理员绕过邀请码白名单（逗号分隔，大小写不敏感）
# 命中该名单的用户名注册时无需邀请码，且自动获得 admin 角色
# 默认包含 ross
ADMIN_BYPASS_USERNAMES=ross

# 应用环境 development | production
APP_ENV=development

# CORS 白名单（逗号分隔）
# 浏览器跨域请求时，仅命中此列表的 Origin 才会返回 Access-Control-Allow-Origin
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 反向代理 IP，多个用逗号分隔，公网部署需包含 Nginx 网段
TRUSTED_PROXIES=127.0.0.1,::1

# ===== 邮件发送 =====
# 发信方式：resend | smtp | log（留空自动判断：优先 resend，其次 smtp，最后 log）
MAIL_PROVIDER=

# 【方式一】Resend HTTP API（服务器直接调用，无需邮箱授权码）
# 到 https://resend.com 注册后在 API Keys 生成
RESEND_API_KEY=
# 发件人。未验证域名时用 onboarding@resend.dev（仅能发给 Resend 账号本人邮箱）；
# 验证域名后改成自己的，如：RESEND_FROM=软考学系 <no-reply@your-domain.com>
RESEND_FROM=软考学系

# 【方式二】SMTP 直连（QQ / 163 / 企业邮箱的授权码，注意不是登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=软考学系
# 单邮箱/单用户每日验证码发送上限（默认 50，按需调整）
EMAIL_DAILY_MAX=50

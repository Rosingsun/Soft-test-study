# 复制为 .env 后按实际环境填写（.env 已被 gitignore，不会提交）

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=softteststudyt

# JWT
# 生产环境务必设置强随机密钥
JWT_SECRET=
JWT_EXPIRES_IN=168

# 服务
SERVER_PORT=3000

# 管理员绕过邀请码白名单（逗号分隔，大小写不敏感）
# 命中该名单的用户名注册时无需邀请码，且自动获得 admin 角色
# 默认包含 ross
ADMIN_BYPASS_USERNAMES=ross

# 应用环境 development | production
APP_ENV=development

# CORS 白名单（逗号分隔）
# 浏览器跨域请求时，仅命中此列表的 Origin 才会返回 Access-Control-Allow-Origin
CORS_ALLOWED_ORIGINS=http://localhost:5173
